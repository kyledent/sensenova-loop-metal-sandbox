# Copied to .env by ./loop on first run. .env is git-ignored. Values are literal (no quotes, no $VARS), and a
# variable already set in your shell wins.

# The quant: Q4_K_M (5.6 GB), Q4_0 (5.3 GB) or Q3_K_M (4.6 GB). Empty: Q3_K_M on a Mac with 8 GB, Q4_K_M on the others.
# ./loop models lists them, and ./loop use Q4_0 sets this and LOOP_CTX for you, and restarts the server.
LOOP_QUANT=

# Where the GGUF files go. The server's sandbox can read this folder and nothing else of yours.
LOOP_MODEL_DIR=./models

# Context in tokens. Empty: by RAM (up to 11 GB 8K, up to 23 GB 16K, up to 35 GB 32K, up to 71 GB 64K, more 128K).
# About 56 KiB of memory per token, on top of the weights. The model's limit is 262144; the fork's author has tested
# it up to 16K.
LOOP_CTX=

# Ports the agent may reach and detection tries. The server listens on the first (on loopback only).
LOOP_PORTS=8080-8083

# Thinking budget (tokens) of requests that do not set one, such as pi's compaction summaries. Empty: a sixteenth of the
# context, which leaves room for the summary.
LOOP_REASONING_BUDGET=

# Prompt cache cap in MiB. Empty: a quarter of the RAM, at most 24576.
LOOP_CACHE_RAM=

# More llama-server arguments, split on spaces
LOOP_SERVER_ARGS=

# The server's API key. Empty: one is generated on first run and kept in .state/api-key. The server always has one,
# as it accepts requests from any web page otherwise. pi's agent can read it.
LOOP_API_KEY=

# 0: build llama.cpp without the build's sandbox (no network, writes only its own folder), if the sandbox refuses
# something the build needs
LOOP_BUILD_SANDBOX=1

# 1: build llama.cpp with this repository's Metal kernels for the model's routing (patches/), so it runs on the GPU.
# 0: without them, as the fork is, with the routing on the CPU. ./loop setup builds each in a folder of its own.
LOOP_METAL_PORT=1

# What the agent's sandbox can connect to:
#   server    only LOOP_PORTS on loopback (the default)
#   loopback  any port on loopback, and it may listen there; for dev servers. This reaches every local service.
#   open      the internet too; for npm, pip and git remotes. The agent can then send out whatever it can read.
LOOP_AGENT_NETWORK=server

# Thinking: 1 offers it in pi (levels off, low, medium, high, xhigh; default high), 0 turns it off.
LOOP_THINKING=1

# Each pi level's thinking budget, as level=budget. Empty: low=2048,medium=4096,high=8192,xhigh=16384. List only the
# levels you change.
LOOP_THINKING_LEVELS=

# Largest max output (tokens) to give pi. Empty: 24576 with thinking, 8192 without. Also capped at a quarter of the
# context.
LOOP_MAX_OUTPUT=

# GitHub token for gh and git in the sandbox. pi's agent can read it, so use a narrow fine-grained token. It only helps
# with LOOP_AGENT_NETWORK=open. Leave empty for none.
GH_TOKEN=

# Folder that the agent works on
WORKSPACE_DIR=./workspace

# pi release (npm @mariozechner/pi-coding-agent). Change and run ./loop setup to upgrade.
PI_VERSION=0.73.1
