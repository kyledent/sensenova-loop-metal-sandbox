#!/bin/bash
# Serve SenseNova Loop 9B Preview on Apple Silicon and use it from the pi coding agent, both under macOS sandboxes.
#
#   ./loop           set up if needed, start the server, open pi in this terminal
#   ./loop doctor    prove that the sandboxes allow and refuse what they should
#
# Written for the bash 3.2 that macOS ships.
set -euo pipefail

ROOT=$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd -P)
STATE="$ROOT/.state"
RUNTIME="$ROOT/.runtime"
AGENT_HOME="$STATE/home"
PID_FILE="$STATE/server.pid"
LOG_FILE="$STATE/server.log"

# The llama.cpp that runs this architecture: GuideboardLabs' fork, two commits on llama.cpp aa588a3. It has no releases,
# so setup builds this commit. Stock llama.cpp refuses these files ("unknown model architecture: 'sensenova_loop'").
LLAMA_REPO=https://github.com/GuideboardLabs/llama.cpp-sensenova-loop.git
LLAMA_COMMIT=fad174ecd8bf22746a626c58e67e193f095aaa46
LLAMA_SRC="$RUNTIME/llama-src"
# Metal kernels for the fork's two routing ops, which it has for the CPU and Vulkan only. See docs/metal.md.
METAL_PATCH="$ROOT/patches/0001-metal-mhc-route-and-merge.patch"

# The fork author's GGUFs, made with its converter: text only, the looped block stored once
HF_REPO=guideboardlabs/SenseNova-Loop-9B-Preview-GGUF
HF_REVISION=7e9e0cf5b77d2fa9ccbca4091c411b47286d0afe
QUANTS="Q4_K_M Q4_0 Q3_K_M"
MODEL_MARKER="$STATE/server.model"

PI_PACKAGE=@mariozechner/pi-coding-agent

die() { echo "loop: $*" >&2; exit 1; }

# .env, as "docker compose" reads it: literal values, and the shell's environment wins
load_env() {
    local line key val
    [ -f "$ROOT/.env" ] || { cp "$ROOT/.env.example" "$ROOT/.env"; echo "Created .env from .env.example"; }
    while IFS= read -r line || [ -n "$line" ]; do
        line=${line%$'\r'}
        case "$line" in ''|\#*) continue ;; esac
        key=${line%%=*}; val=${line#*=}
        case "$key" in ''|*[!A-Za-z0-9_]*) continue ;; esac
        if [ -z "${!key+x}" ]; then export "$key=$val"; fi
    done < "$ROOT/.env"
}

# A quant, pinned by the repository's commit and the file's checksum. Sets the variables that name its file.
load_quant() {
    MODEL_FILE="SenseNova-Loop-9B-Preview-$1.gguf"
    case "$1" in
        Q4_K_M) MODEL_SHA256=521696d7e148c71773826e41d3c5f12b4a5d25278dcbecf93a21d9848d7624a2; MODEL_SIZE=5628723360 ;;
        Q4_0)   MODEL_SHA256=753998a3e0071c153d1b9528bce9040bbeb2dcece531b39748fe089fd4fb28e0; MODEL_SIZE=5325947040 ;;
        Q3_K_M) MODEL_SHA256=02fa9b5c21ca4c60a8fac3fcbcfccbf2c87d5c6928be98de2666234cc251ba9e; MODEL_SIZE=4642406560 ;;
        *) die "LOOP_QUANT must be Q4_K_M, Q4_0 or Q3_K_M, not $1" ;;
    esac
}

# The server lets any web page call it (CORS allows every origin), so it always has a key: LOOP_API_KEY, or one
# generated once and kept in .state, which the agent's sandbox cannot read. The agent gets it in its environment.
api_key_default() {
    local file="$STATE/api-key"
    [ -z "${LOOP_API_KEY:-}" ] || return 0
    if [ ! -s "$file" ]; then
        mkdir -p "$STATE"
        ( umask 077; od -An -tx1 -N24 /dev/urandom | tr -d ' \n' > "$file" )
    fi
    LOOP_API_KEY=$(cat "$file")
    export LOOP_API_KEY
}

# A relative path in .env is relative to this folder
abs_path() {
    case "$1" in /*) echo "$1" ;; *) echo "$ROOT/${1#./}" ;; esac
}

# Q3_K_M where an 8 GB Mac's GPU has no room for more, Q4_K_M elsewhere
quant_default() {
    if [ -n "${LOOP_QUANT:-}" ]; then echo "$LOOP_QUANT" | tr 'a-z' 'A-Z'
    elif [ "$(mem_gb)" -le 11 ]; then echo Q3_K_M
    else echo Q4_K_M; fi
}

load_config() {
    local key
    SHELL_QUANT=$(echo "${LOOP_QUANT:-}" | tr 'a-z' 'A-Z')   # asked for on this command line, unlike one in .env
    SHELL_OVERRIDES=""   # what the shell sets, which wins over what ./loop use writes to .env
    for key in LOOP_QUANT LOOP_CTX LOOP_METAL_PORT; do
        [ -z "${!key+x}" ] || SHELL_OVERRIDES="$SHELL_OVERRIDES $key"
    done
    load_env
    api_key_default
    QUANT=$(quant_default)
    load_quant "$QUANT"
    MODEL_DIR=$(abs_path "${LOOP_MODEL_DIR:-./models}")
    WORKSPACE=$(abs_path "${WORKSPACE_DIR:-./workspace}")
    PORTS="${LOOP_PORTS:-8080-8083}"
    PORT=$(expand_ports "$PORTS" | head -n 1)
    NETWORK="${LOOP_AGENT_NETWORK:-server}"
    case "$NETWORK" in server|loopback|open) ;; *) die "LOOP_AGENT_NETWORK must be server, loopback or open, not $NETWORK" ;; esac
    PI_VERSION="${PI_VERSION:-0.73.1}"
    PI_DIR="$RUNTIME/pi"
    runtime_paths
    BASE_URL="http://127.0.0.1:$PORT"
    SANDBOX_EXEC=$(command -v sandbox-exec) || die "sandbox-exec not found: this needs macOS"
}

# The build in use: a folder of its own for each commit, and for each version of the Metal patch
runtime_paths() {
    METAL_PORT="${LOOP_METAL_PORT:-1}"
    RUNTIME_ID=${LLAMA_COMMIT:0:12}
    if [ "$METAL_PORT" != 0 ]; then RUNTIME_ID="$RUNTIME_ID-metal-$(shasum -a 256 "$METAL_PATCH" | cut -c 1-8)"; fi
    LLAMA_DIR="$RUNTIME/llama/$RUNTIME_ID"
    LLAMA_SERVER="$LLAMA_DIR/llama-server"
    LLAMA_TESTS="$LLAMA_DIR/test-backend-ops"
}

# "8080-8083 8100" -> 8080 8081 8082 8083 8100
expand_ports() {
    local p
    for p in ${1//,/ }; do
        case "$p" in
            *[!0-9-]*|'') die "bad port in LOOP_PORTS: $p" ;;
            *-*) seq "${p%-*}" "${p#*-}" ;;
            *) echo "$p" ;;
        esac
    done
}

mem_gb() { echo $(( $(sysctl -n hw.memsize) / 1073741824 )); }

# Context by RAM, in the tiers of Prism ML's Bonsai-demo. The KV cache is about 56 KiB per token: 14 full-attention passes
# (8 stored layers, 6 of them run twice) of 4 KV heads of 256, in f16. The linear-attention layers' state is fixed.
ctx_default() {
    if [ -n "${LOOP_CTX:-}" ] && [ "$LOOP_CTX" != 0 ]; then echo "$LOOP_CTX"; return; fi
    local gb; gb=$(mem_gb)
    if [ "$gb" -le 11 ]; then echo 8192
    elif [ "$gb" -le 23 ]; then echo 16384
    elif [ "$gb" -le 35 ]; then echo 32768
    elif [ "$gb" -le 71 ]; then echo 65536
    else echo 131072; fi
}

# Prism ML's single-user advice for its models is --cache-ram 24576, which is too much for a small Mac: at most a quarter of
# the RAM
cache_ram_default() {
    if [ -n "${LOOP_CACHE_RAM:-}" ]; then echo "$LOOP_CACHE_RAM"; return; fi
    local mib=$(( $(mem_gb) * 1024 / 4 ))
    if [ "$mib" -gt 24576 ]; then echo 24576; else echo "$mib"; fi
}

# The model's generation config: temperature 1.0 and top-p 0.95. Top-k 50 and no min-p are transformers' defaults, so
# this samples as the reference does, where llama.cpp's own defaults (40, 0.05) would differ.
sampling_args() {
    echo --temp 1.0 --top-p 0.95 --top-k 50 --min-p 0
}

# The budget of requests that set none. pi's compaction summaries are such requests, with 80% of the reserve (a quarter
# of the context, at most 24K) as their max output, so thinking must leave room for the summary: a sixteenth of the context
reasoning_budget_default() {
    if [ -n "${LOOP_REASONING_BUDGET:-}" ]; then echo "$LOOP_REASONING_BUDGET"; return; fi
    echo $(( $(ctx_default) / 16 ))
}

# download URL DEST SHA256 SIZE: resumable, and DEST appears only after the checksum passes
download() {
    local url=$1 dest=$2 sha=$3 size=$4 part="$2.part" got
    if [ -f "$dest" ]; then
        [ "$(wc -c < "$dest" | tr -d ' ')" = "$size" ] || die "$dest has the wrong size; delete it and run setup again"
        return 0
    fi
    mkdir -p "$(dirname "$dest")"
    if [ ! -f "$part" ] || [ "$(wc -c < "$part" | tr -d ' ')" != "$size" ]; then
        echo "Downloading $(basename "$dest") ($(( size / 1048576 )) MiB)"
        curl -fL --retry 3 -C - -o "$part" "$url"
    fi
    got=$(shasum -a 256 "$part" | cut -d ' ' -f 1)
    if [ "$got" != "$sha" ]; then
        rm -f "$part"
        die "checksum mismatch for $(basename "$dest"): expected $sha, got $got"
    fi
    mv "$part" "$dest"
}

# Fetches the pinned commit, checks that it is the one asked for, applies the Metal patch, and builds llama-server from
# it: one static binary with Metal's shaders inside, and without the web UI, which the build would download. With the
# patch, it also builds test-backend-ops, which compares the patch's kernels with the CPU's. The build runs in
# sandbox/build.sb, with a clean environment: no network, and it writes only its own folder and the compiler's caches.
# LOOP_BUILD_SANDBOX=0 builds without the sandbox, and LOOP_METAL_PORT=0 without the patch.
build_llama() {
    local cache temp src cmake_bin tests=OFF targets=(llama-server) run=()
    echo "Building llama.cpp's SenseNova Loop fork at $RUNTIME_ID. This takes a few minutes."
    if [ ! -d "$LLAMA_SRC/.git" ]; then rm -rf "$LLAMA_SRC"; git init -q "$LLAMA_SRC"; fi
    git -C "$LLAMA_SRC" fetch -q --depth 1 "$LLAMA_REPO" "$LLAMA_COMMIT"
    git -C "$LLAMA_SRC" -c advice.detachedHead=false checkout -q --force FETCH_HEAD
    [ "$(git -C "$LLAMA_SRC" rev-parse HEAD)" = "$LLAMA_COMMIT" ] || die "the fork's checkout is not $LLAMA_COMMIT"
    git -C "$LLAMA_SRC" clean -qfdx -e build
    if [ "$METAL_PORT" != 0 ]; then
        git -C "$LLAMA_SRC" apply --check "$METAL_PATCH" 2>/dev/null \
            || die "the Metal patch does not apply to $LLAMA_COMMIT. ./loop use cpu builds without it"
        git -C "$LLAMA_SRC" apply "$METAL_PATCH"
        tests=ON; targets+=(test-backend-ops)
    fi
    cache=$(cd "$(getconf DARWIN_USER_CACHE_DIR)" && pwd -P)
    temp=$(cd "$(getconf DARWIN_USER_TEMP_DIR)" && pwd -P)
    src=$(cd "$LLAMA_SRC" && pwd -P)
    cmake_bin=$(command -v cmake)
    if [ "${LOOP_BUILD_SANDBOX:-1}" != 0 ]; then
        run=("$SANDBOX_EXEC" -f "$ROOT/sandbox/build.sb" -D "SRC=$src" -D "CACHE_DIR=$cache" -D "TEMP_DIR=$temp")
    fi
    run=(env -i "PATH=/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin" "HOME=$src" "TMPDIR=$temp/"
        "LANG=${LANG:-en_US.UTF-8}" ${run[@]+"${run[@]}"})
    ( cd "$src" \
        && "${run[@]}" "$cmake_bin" -S . -B build -DCMAKE_BUILD_TYPE=Release -DBUILD_SHARED_LIBS=OFF \
            -DGGML_METAL=ON -DGGML_METAL_EMBED_LIBRARY=ON -DLLAMA_OPENSSL=OFF -DLLAMA_BUILD_TESTS="$tests" \
            -DLLAMA_BUILD_EXAMPLES=OFF -DLLAMA_BUILD_APP=OFF -DLLAMA_BUILD_UI=OFF -DLLAMA_USE_PREBUILT_UI=OFF \
        && "${run[@]}" "$cmake_bin" --build build --target "${targets[@]}" -j "$(sysctl -n hw.ncpu)" ) \
        || die "the build failed. If the sandbox refused something, LOOP_BUILD_SANDBOX=0 ./loop setup builds without it"
    local target
    for target in "${targets[@]}"; do
        [ -x "$src/build/bin/$target" ] || die "the build made no build/bin/$target"
    done
    rm -rf "$LLAMA_DIR"; mkdir -p "$LLAMA_DIR"
    for target in "${targets[@]}"; do cp "$src/build/bin/$target" "$LLAMA_DIR/"; done
}

cmd_setup() {
    [ "$(uname -s)" = Darwin ] && [ "$(uname -m)" = arm64 ] || die "this needs macOS on Apple Silicon"
    local tool
    for tool in curl shasum jq node npm git cmake; do
        command -v "$tool" >/dev/null || die "$tool not found (brew install $tool; node brings npm)"
    done
    xcrun --find clang >/dev/null 2>&1 || die "no C compiler: install the Xcode Command Line Tools with xcode-select --install"
    node -e 'const [a,b]=process.versions.node.split(".").map(Number);process.exit(a>20||(a===20&&b>=6)?0:1)' \
        || die "pi needs node 20.6 or newer, found $(node --version)"

    if [ ! -x "$LLAMA_SERVER" ]; then build_llama; fi

    download "https://huggingface.co/$HF_REPO/resolve/$HF_REVISION/$MODEL_FILE" \
        "$MODEL_DIR/$MODEL_FILE" "$MODEL_SHA256" "$MODEL_SIZE"

    # Install scripts would run outside the sandbox, so they are not run
    if [ "$(cat "$PI_DIR/.version" 2>/dev/null || true)" != "$PI_VERSION" ]; then
        echo "Installing pi $PI_VERSION"
        rm -rf "$PI_DIR"
        npm install -g --no-fund --no-audit --ignore-scripts --prefix "$PI_DIR" "$PI_PACKAGE@$PI_VERSION"
        echo "$PI_VERSION" > "$PI_DIR/.version"
    fi
}

require_setup() {
    if [ ! -x "$LLAMA_SERVER" ] || [ ! -f "$MODEL_DIR/$MODEL_FILE" ] || [ ! -x "$PI_DIR/bin/pi" ]; then
        cmd_setup
    fi
    mkdir -p "$STATE" "$WORKSPACE"
}

# Sets SERVER_SANDBOX to the command line that runs a program in the server's sandbox, with a clean environment: by
# default llama-server, or another of the build's programs
server_sandbox() {
    local bin=${1:-$LLAMA_SERVER} cache temp
    cache=$(cd "$(getconf DARWIN_USER_CACHE_DIR)" && pwd -P)
    temp=$(cd "$(getconf DARWIN_USER_TEMP_DIR)" && pwd -P)
    mkdir -p "$MODEL_DIR"
    SERVER_SANDBOX=(env -i "PATH=/usr/bin:/bin" "HOME=$HOME" "TMPDIR=$temp/" "LANG=${LANG:-en_US.UTF-8}")
    # Not on the command line, where ps would show it
    SERVER_SANDBOX+=("LLAMA_API_KEY=$LOOP_API_KEY")
    # Prism ML's workaround for an out-of-memory error in ggml's Metal backend on M5 with macOS 26.2 to 26.4
    if [ -n "${GGML_METAL_TENSOR_DISABLE:-}" ]; then SERVER_SANDBOX+=("GGML_METAL_TENSOR_DISABLE=$GGML_METAL_TENSOR_DISABLE"); fi
    SERVER_SANDBOX+=("$SANDBOX_EXEC" -f "$ROOT/sandbox/server.sb"
        -D "BIN=$bin" -D "BIN_DIR=$LLAMA_DIR" -D "MODEL_DIR=$(cd "$MODEL_DIR" && pwd -P)" -D "PORT=$PORT"
        -D "CACHE_DIR=$cache" -D "TEMP_DIR=$temp" -D "LOG_FILE=$LOG_FILE")
}

server_pid() {
    local pid
    if pid=$(cat "$PID_FILE" 2>/dev/null); then
        case "$(ps -p "$pid" -o command= 2>/dev/null || true)" in
            *llama-server*) echo "$pid"; return 0 ;;
        esac
        rm -f "$PID_FILE"
    fi
    # One of ours whose pid file is gone: found by its port, so that down and restart can still stop it. Its quant is
    # unknown, so asking for one on the command line makes up stop and say to switch.
    pid=$(lsof -nP -t -iTCP:"$PORT" -sTCP:LISTEN 2>/dev/null | head -n 1) || return 1
    case "$(ps -p "${pid:-0}" -o command= 2>/dev/null || true)" in
        "$RUNTIME/llama/"*llama-server*) echo "$pid" > "$PID_FILE"; rm -f "$MODEL_MARKER"; echo "$pid" ;;
        *) return 1 ;;
    esac
}

server_healthy() { curl -fsS --connect-timeout 1 -m 3 "$BASE_URL/health" >/dev/null 2>&1; }

# An empty request without the key: 401 when the server enforces it, 400 when it has none
server_wants_key() {
    [ "$(curl -s -o /dev/null -w '%{http_code}' -m 5 -X POST -H 'Content-Type: application/json' -d '{}' \
        "$BASE_URL/v1/chat/completions" 2>/dev/null)" = 401 ]
}

cmd_up() {
    require_setup
    if server_pid >/dev/null; then
        local running wanted="$QUANT $RUNTIME_ID"
        running=$(cat "$MODEL_MARKER" 2>/dev/null || echo unknown)
        if [ "$running" = "$wanted" ]; then
            echo "Server already running on port $PORT"
        elif [ -n "$SHELL_QUANT" ]; then
            die "the server is running $running, not $wanted. To switch: ./loop use $QUANT"
        else
            echo "Server already running $running on port $PORT (.env says $wanted; ./loop restart switches to it)"
        fi
    elif server_healthy; then
        echo "Something else already serves port $PORT; using it"
        return 0
    else
        local args
        # shellcheck disable=SC2207  # split into words on purpose
        args=(-m "$MODEL_DIR/$MODEL_FILE" --host 127.0.0.1 --port "$PORT"
            --alias "sensenova-loop-9b-$(echo "$QUANT" | tr 'A-Z_' 'a-z-')"
            -ngl 99 -fa on -c "$(ctx_default)"
            $(sampling_args)
            --jinja --reasoning-format deepseek --reasoning-budget "$(reasoning_budget_default)"
            --parallel 1 --cache-ram "$(cache_ram_default)" --no-webui)
        # shellcheck disable=SC2206  # split into words on purpose
        args+=(${LOOP_SERVER_ARGS:-})
        server_sandbox
        # From its own folder: ggml lists the current one for backends, and the sandbox refuses this repository's
        ( cd "$LLAMA_DIR" && exec nohup "${SERVER_SANDBOX[@]}" "$LLAMA_SERVER" "${args[@]}" > "$LOG_FILE" 2>&1 < /dev/null ) &
        echo $! > "$PID_FILE"
        echo "$QUANT $RUNTIME_ID" > "$MODEL_MARKER"
        echo "Starting the $QUANT server on port $PORT (log: $LOG_FILE)"
    fi
    local waited=0 limit="${LOOP_START_TIMEOUT:-300}"
    until server_healthy; do
        if ! server_pid >/dev/null; then
            tail -n 20 "$LOG_FILE" >&2 || true
            die "the server stopped while loading. Run ./loop doctor to check the sandbox"
        fi
        if [ "$waited" -ge "$limit" ]; then die "the server is not ready after ${limit}s; see $LOG_FILE"; fi
        sleep 1; waited=$(( waited + 1 ))
    done
}

cmd_down() {
    local pid n=0
    if ! pid=$(server_pid); then echo "Server not running"; return 0; fi
    kill "$pid"
    while kill -0 "$pid" 2>/dev/null && [ "$n" -lt 30 ]; do sleep 1; n=$(( n + 1 )); done
    if kill -0 "$pid" 2>/dev/null; then kill -9 "$pid"; fi
    rm -f "$PID_FILE" "$MODEL_MARKER"
    echo "Server stopped"
}

# The generated profile: sandbox/agent.sb, the network mode, the terminal in use
render_agent_profile() {
    local p t
    cat "$ROOT/sandbox/agent.sb"
    case "$NETWORK" in
        server)
            for p in $(expand_ports "$PORTS"); do
                echo "(allow network-outbound (remote ip \"localhost:$p\"))"
            done ;;
        loopback)
            echo '(allow network-bind network-inbound (local ip "localhost:*"))'
            echo '(allow network-outbound (remote ip "localhost:*"))' ;;
        open)
            echo '(allow network-bind network-inbound (local ip "localhost:*"))'
            echo '(allow network-outbound)' ;;
    esac
    if t=$(tty 2>/dev/null); then
        echo "(allow file-read* file-write* file-ioctl (literal \"$t\"))"
    fi
}

# agent_run CMD...: run a program in the agent's sandbox, with a clean environment, in the workspace
agent_run() {
    local node_bin node_dir node_prefix jq_dir var
    node_bin=$(node -p 'process.execPath')
    node_dir=$(dirname "$(command -v node)")
    node_prefix=$(dirname "$(dirname "$node_bin")")
    jq_dir=$(dirname "$(command -v jq)")
    mkdir -p "$AGENT_HOME/tmp" "$WORKSPACE" "$STATE"
    render_agent_profile > "$STATE/agent.sb"
    local env_args=("HOME=$AGENT_HOME" "TMPDIR=$AGENT_HOME/tmp"
        "PATH=$ROOT/agent/bin:$AGENT_HOME/.local/bin:$node_dir:$jq_dir:/opt/homebrew/bin:/opt/homebrew/sbin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin"
        "LOOP_PI_BIN=$PI_DIR/bin/pi" "LOOP_AGENT_DIR=$ROOT/agent" "LOOP_PORTS=$PORTS"
        "USER=${USER:-dev}" "TERM=${TERM:-xterm-256color}" "LANG=${LANG:-en_US.UTF-8}")
    # What pi and the detection read, and nothing else of the calling shell's: its secrets stay out
    for var in LOOP_THINKING LOOP_THINKING_LEVELS LOOP_MAX_OUTPUT LOOP_API_KEY GH_TOKEN TZ COLORTERM TERM_PROGRAM; do
        if [ -n "${!var:-}" ]; then env_args+=("$var=${!var}"); fi
    done
    (
        cd "$WORKSPACE"
        exec env -i "${env_args[@]}" "$SANDBOX_EXEC" -f "$STATE/agent.sb" \
            -D "AGENT_HOME=$AGENT_HOME" -D "WORKSPACE=$(pwd -P)" -D "PI_DIR=$PI_DIR" \
            -D "AGENT_DIR=$ROOT/agent" -D "NODE_PREFIX=$node_prefix" "$@"
    )
}

cmd_models() {
    local q state running=""
    if server_pid >/dev/null; then running=$(cat "$MODEL_MARKER" 2>/dev/null || true); fi
    echo "SenseNova Loop 9B Preview, from $HF_REPO"
    printf '  %-8s %-9s %s\n' QUANT WEIGHTS FILE
    for q in $QUANTS; do
        load_quant "$q"
        state="not downloaded"
        if [ -f "$MODEL_DIR/$MODEL_FILE" ]; then state=downloaded; fi
        if [ "$q" = "$QUANT" ]; then state="$state, selected"; fi
        if [ "$q" = "${running%% *}" ]; then state="$state, running"; fi
        printf '  %-8s %-9s %s (%s)\n' "$q" "$(( MODEL_SIZE / 1000000 )) MB" "$MODEL_FILE" "$state"
    done
    load_quant "$QUANT"
    echo
    echo "Build: $RUNTIME_ID, with the routing on $([ "$METAL_PORT" = 0 ] && echo the CPU || echo Metal)"
    echo "To switch: ./loop use Q4_0, or a context (32K, or auto), or cpu or metal for the routing, in any combination"
}

# Sets KEY=VALUE in .env, in place of the first KEY= line, or at the end
env_set() {
    local tmp="$ROOT/.env.$$"
    awk -v k="$1" -v v="$2" '
        !done && index($0, k "=") == 1 { print k "=" v; done = 1; next }
        { print }
        END { if (!done) print k "=" v }' "$ROOT/.env" > "$tmp"
    mv "$tmp" "$ROOT/.env"
}

# The memory a context needs, in MiB: the weights, the context's KV cache at 56 KiB per token, and 256 MiB for the
# linear-attention state and the compute buffers. A rough guide.
mem_need_mib() {
    echo $(( (MODEL_SIZE + $1 * 57344) / 1048576 + 256 ))
}

# What macOS lets the GPU use, roughly: three quarters of the RAM
gpu_mib() { echo $(( $(mem_gb) * 1024 * 3 / 4 )); }

# The selected setup's memory against what the GPU may use
fit_warning() {
    local ctx need have
    ctx=$(ctx_default)
    need=$(mem_need_mib "$ctx")
    have=$(gpu_mib)
    if [ "$need" -gt "$have" ]; then
        echo "Warning: $QUANT with a $ctx-token context needs about $(( need / 1024 + 1 )) GB, more than the" \
            "$(( have / 1024 )) GB or so that the GPU may use on this Mac. A smaller context or quant would fit better" >&2
    fi
}

# ./loop use [Q4_K_M|Q4_0|Q3_K_M] [32K|32768|auto] [metal|cpu], in any order: builds and downloads what that needs
# while the running server keeps serving, keeps the choice in .env, and restarts the server with it. If the new server
# does not start, .env and the previous server come back. metal and cpu choose the build with or without the Metal
# patch, which runs the model's routing on the GPU or the CPU.
cmd_use() {
    local arg up quant="" ctx="" ctx_set=0 port=""
    [ $# -gt 0 ] || die "use: name a quant (Q4_K_M, Q4_0 or Q3_K_M), a context (32K, or auto), or metal or cpu"
    for arg in "$@"; do
        up=$(echo "$arg" | tr 'a-z' 'A-Z')
        case "$up" in
            Q4_K_M|Q4KM|Q4_0|Q3_K_M|Q3KM) quant=$(echo "$up" | sed 's/^Q\([0-9]\)KM$/Q\1_K_M/') ;;
            AUTO) ctx=""; ctx_set=1 ;;
            METAL) port=1 ;;
            CPU|NOMETAL) port=0 ;;
            *)
                [[ $up =~ ^[0-9]+K?$ ]] || die "use: $arg is not a quant (Q4_K_M, Q4_0 or Q3_K_M), a context, or metal or cpu"
                ctx=$(( 10#${up%K} ))
                if [ "${up%K}" != "$up" ]; then ctx=$(( ctx * 1024 )); fi
                if [ "$ctx" -lt 2048 ] || [ "$ctx" -gt 262144 ]; then die "use: a context of 2K to 256K, not $arg"; fi
                ctx_set=1 ;;
        esac
    done

    # What runs now, to compare with and to come back to
    local was_running=0 running="" served_ctx=""
    if server_pid >/dev/null; then
        was_running=1
        running=$(cat "$MODEL_MARKER" 2>/dev/null || true)
        served_ctx=$(curl -fsS -m 3 -H "Authorization: Bearer $LOOP_API_KEY" "$BASE_URL/props" 2>/dev/null \
            | jq -r '.default_generation_settings.n_ctx // empty' 2>/dev/null || true)
    elif server_healthy; then
        die "something other than ./loop serves port $PORT; stop it first"
    fi
    local old_quant=$QUANT old_ctx=${served_ctx:-${LOOP_CTX:-}} old_port=$METAL_PORT
    if [ -n "$running" ]; then
        old_quant=${running%% *}
        case "$running" in *-metal-*) old_port=1 ;; *" "*) old_port=0 ;; esac
    fi

    QUANT=${quant:-$QUANT}
    if [ "$ctx_set" = 1 ]; then LOOP_CTX=$ctx; fi
    LOOP_METAL_PORT=${port:-$METAL_PORT}
    export LOOP_QUANT="$QUANT" LOOP_CTX="${LOOP_CTX:-}" LOOP_METAL_PORT
    load_quant "$QUANT"
    runtime_paths
    fit_warning
    require_setup

    cp "$ROOT/.env" "$STATE/env.previous"
    env_set LOOP_QUANT "$QUANT"
    if [ "$ctx_set" = 1 ]; then env_set LOOP_CTX "$ctx"; fi
    if [ -n "$port" ]; then env_set LOOP_METAL_PORT "$port"; fi
    if [ -n "$SHELL_OVERRIDES" ]; then
        echo "Note: your shell sets$SHELL_OVERRIDES, which wins over .env, so other commands will not see this choice." \
            "Unset it: unset$SHELL_OVERRIDES" >&2
    fi

    if [ "$running" = "$QUANT $RUNTIME_ID" ] && [ "$served_ctx" = "$(ctx_default)" ]; then
        echo "Already serving $QUANT with a $served_ctx-token context, on $RUNTIME_ID. .env keeps it"
        return 0
    fi
    if [ "$was_running" = 1 ]; then cmd_down; fi
    SHELL_QUANT=""
    if ( cmd_up ); then
        echo "Now serving $QUANT with a $(ctx_default)-token context, on $RUNTIME_ID. .env keeps it, so ./loop uses it from now on"
        echo "pi picks it up when it starts. In a pi that is already open: ./loop detect in another terminal, then /model"
        return 0
    fi
    cp "$LOG_FILE" "$STATE/server.failed.log" 2>/dev/null || true
    cp "$STATE/env.previous" "$ROOT/.env"
    if [ "$was_running" = 1 ]; then
        echo "Starting $old_quant again" >&2
        LOOP_QUANT="$old_quant" LOOP_CTX="$old_ctx" LOOP_METAL_PORT="$old_port" "$ROOT/loop" up >&2 || true
    fi
    die "$QUANT did not start, so .env is as it was. Its log: $STATE/server.failed.log"
}

CTX_SIZES="8192 16384 32768 65536 131072 262144"

# ./loop ctx: each context size, with the memory it needs for the selected quant, and a choice of one, which use then
# serves and keeps in .env. ./loop ctx 32K, or auto, chooses without the list. The choice is read from the terminal,
# or from stdin: "echo 2 | ./loop ctx" picks the second size.
cmd_ctx() {
    local c i=0 n current by_ram have need note ans choice
    if [ $# -gt 0 ]; then
        case "$(echo "$1" | tr 'a-z' 'A-Z')" in AUTO|[0-9]*) cmd_use "$1"; return ;; esac
        die "ctx: a context size (32K, 32768) or auto, not $1"
    fi
    by_ram=$(LOOP_CTX='' ctx_default)
    current=$(ctx_default)
    if server_healthy; then
        n=$(curl -fsS -m 3 -H "Authorization: Bearer $LOOP_API_KEY" "$BASE_URL/props" 2>/dev/null \
            | jq -r '.default_generation_settings.n_ctx // empty' 2>/dev/null || true)
        if [ -n "$n" ]; then current=$n; fi
        echo "The server serves $QUANT with a $current-token context."
    else
        echo "$QUANT is selected, with a $current-token context. The server is not running."
    fi
    have=$(gpu_mib)
    echo "The GPU may use about $(( have / 1024 )) GB of this Mac's $(mem_gb) GB. Estimated memory for each context:"
    for c in $CTX_SIZES; do
        i=$(( i + 1 ))
        need=$(mem_need_mib "$c")
        note=""
        if [ "$c" = "$current" ]; then note="current"; fi
        if [ "$c" = "$by_ram" ]; then note="${note:+$note, }default for this Mac"; fi
        if [ "$need" -gt "$have" ]; then note="${note:+$note, }too big"; fi
        printf '  %d) %4sK  about %s GB%s\n' "$i" "$(( c / 1024 ))" \
            "$(awk -v m="$need" 'BEGIN { printf "%.1f", m / 1024 }')" "${note:+   ($note)}"
    done
    echo "  a) auto: by RAM, now $(( by_ram / 1024 ))K"
    printf 'Choose 1-%d or a, or press Enter to keep it: ' "$i" >&2
    if ! read -r ans; then ans=""; echo >&2; fi
    case "$ans" in
        '') echo "Kept a $current-token context"; return 0 ;;
        a|A|auto) choice=auto ;;
        *[!0-9]*) die "ctx: $ans is not one of the choices" ;;
        *)
            if [ "$ans" -lt 1 ] || [ "$ans" -gt "$i" ]; then die "ctx: $ans is not one of the choices"; fi
            choice=$(echo $CTX_SIZES | cut -d ' ' -f "$ans") ;;
    esac
    cmd_use "$choice"
}

cmd_status() {
    local pid
    if pid=$(server_pid); then echo "server: running, pid $pid, port $PORT"; else echo "server: not started by ./loop"; fi
    if server_healthy; then
        curl -fsS -m 3 -H "Authorization: Bearer $LOOP_API_KEY" "$BASE_URL/props" 2>/dev/null \
            | jq -r '"ready: \(.model_alias // "?"), ctx \(.default_generation_settings.n_ctx // "?")"' 2>/dev/null \
            || echo "ready"
    else
        echo "port $PORT: no healthy server"
    fi
}

DOCTOR_FAILS=0
expect_ok() {
    local label=$1; shift
    if "$@" >/dev/null 2>&1; then echo "  ok    $label"
    else echo "  FAIL  $label"; DOCTOR_FAILS=$(( DOCTOR_FAILS + 1 )); fi
}
expect_refused() {
    local label=$1; shift
    if "$@" >/dev/null 2>&1; then echo "  FAIL  $label (it was allowed)"; DOCTOR_FAILS=$(( DOCTOR_FAILS + 1 ))
    else echo "  ok    $label"; fi
}

# Exit 0 if this llama-server command line reports a Metal device
lists_metal() {
    local devices
    devices=$("$@" --list-devices 2>&1) || return 1
    echo "$devices" | grep -qiE 'metal|mtl'
}

# The patch's Metal kernels against the CPU's, with test-backend-ops in the server's sandbox: every case must pass on
# Metal, none may be left to the CPU
check_metal_kernels() {
    local out ok
    if [ "$METAL_PORT" = 0 ]; then
        echo "  note  the mHC routing runs on the CPU, in a build without the Metal patch. ./loop use metal switches"
        return
    fi
    server_sandbox "$LLAMA_TESTS"
    out=$("${SERVER_SANDBOX[@]}" "$LLAMA_TESTS" test -b MTL0 -o MHC_ROUTE,MHC_MERGE 2>&1) || true
    ok=$(printf '%s\n' "$out" | grep -cE 'MHC_(ROUTE|MERGE)\(.*OK' || true)
    expect_ok "the Metal routing kernels match the CPU's ($ok of 16 cases)" \
        sh -c '[ "$1" = 16 ] && ! printf "%s\n" "$2" | grep -qE "FAIL|not supported"' _ "$ok" "$out"
    if [ "$ok" != 16 ]; then
        echo "        test-backend-ops says:"
        printf '%s\n' "$out" | grep -E 'MHC_|FAIL|rror|supported' | tail -n 12 | sed 's/^/        /' || true
        echo "        ./loop use cpu switches to a build without the patch, with the routing on the CPU"
    fi
    server_sandbox
}

# The server's last start, from its log. llama-server warns when it finds no GPU and falls back to the CPU. At its
# default log level, it does not say where the layers went, so that line is only there with -lv 4.
check_server_log() {
    local line n on total splits
    if [ ! -s "$LOG_FILE" ]; then
        echo "  skip  server log: start the server with ./loop up, then run doctor again"
        return
    fi
    expect_refused "the server's last start found a GPU" grep -q 'no usable GPU' "$LOG_FILE"
    splits=$(grep -oE 'graph splits = [0-9]+' "$LOG_FILE" | tail -n 1 || true)
    if [ -n "$splits" ]; then echo "  note  $splits: each is a hop between the GPU and the CPU"; fi
    line=$(grep -oE 'offloaded [0-9]+/[0-9]+ layers to GPU' "$LOG_FILE" | tail -n 1 || true)
    if [ -z "$line" ]; then
        echo "  skip  server log: it does not say where the layers went. Watch % GPU in Activity Monitor instead"
        return
    fi
    n=${line#offloaded }; n=${n%% *}; on=${n%/*}; total=${n#*/}
    expect_ok "the server's last start put all its layers on the GPU ($on/$total)" [ "$on" = "$total" ]
    if [ "$on" != "$total" ]; then
        echo "        from $LOG_FILE:"
        grep -iE 'metal|gpu|mtl' "$LOG_FILE" | tail -n 10 | sed 's/^/        /' || true
    fi
}

cmd_doctor() {
    require_setup
    local canary="$HOME/.loop-doctor-canary" state_canary="$STATE/doctor-canary"
    local denied="$HOME/.loop-doctor-denied" probe="$WORKSPACE/.loop-doctor"
    echo secret > "$canary"; echo secret > "$state_canary"; rm -f "$denied"
    # shellcheck disable=SC2064  # expand now
    trap "rm -f '$canary' '$state_canary' '$denied' '$probe'" EXIT

    server_sandbox
    cd "$LLAMA_DIR"   # as ./loop up runs it; every path below is absolute
    echo "Server sandbox"
    expect_ok "llama-server sees Metal without a sandbox" lists_metal "$LLAMA_SERVER"
    expect_ok "llama-server sees Metal in the sandbox" lists_metal "${SERVER_SANDBOX[@]}" "$LLAMA_SERVER"
    if ! lists_metal "${SERVER_SANDBOX[@]}" "$LLAMA_SERVER"; then
        echo "        its output:"
        "${SERVER_SANDBOX[@]}" "$LLAMA_SERVER" --list-devices 2>&1 | tail -n 15 | sed 's/^/        /' || true
    fi
    expect_refused "it cannot start a shell" "${SERVER_SANDBOX[@]}" /bin/sh -c true
    check_metal_kernels
    check_server_log

    echo "Agent sandbox (network: $NETWORK)"
    expect_ok "it can run a program at all" agent_run /usr/bin/true
    expect_ok "node runs" agent_run node --version
    expect_ok "pi runs" agent_run "$PI_DIR/bin/pi" --version
    expect_ok "git runs" agent_run git --version
    expect_ok "it can write the workspace" agent_run /usr/bin/touch "$probe"
    expect_ok "it can write its home" agent_run /usr/bin/touch "$AGENT_HOME/.doctor"
    expect_refused "it cannot read your home ($canary)" agent_run /bin/cat "$canary"
    expect_refused "it cannot write your home" agent_run /usr/bin/touch "$denied"
    expect_refused "it cannot read this repo's .state and .env" agent_run /bin/cat "$state_canary"
    expect_refused "it cannot change pi's install" agent_run /usr/bin/touch "$PI_DIR/.doctor"
    expect_refused "it cannot change the sandbox profiles" agent_run /usr/bin/touch "$ROOT/sandbox/agent.sb"
    if [ "$NETWORK" != open ]; then
        if curl -fsS -m 5 -o /dev/null https://example.com 2>/dev/null; then
            expect_refused "it cannot reach the internet" agent_run /usr/bin/curl -fsS -m 5 -o /dev/null https://example.com
        else
            echo "  skip  internet check: this Mac cannot reach example.com either"
        fi
    fi
    if server_healthy; then
        expect_ok "it can reach the server" agent_run /usr/bin/curl -fsS -m 3 -o /dev/null "$BASE_URL/health"
        expect_ok "the server refuses requests without its key" server_wants_key
        if ! server_wants_key; then echo "        it was started without one: run ./loop restart"; fi
    else
        echo "  skip  server check: start it with ./loop up, then run doctor again"
    fi

    if [ "$DOCTOR_FAILS" -gt 0 ]; then
        echo
        echo "$DOCTOR_FAILS check(s) failed. The sandbox's refusals are in the system log:"
        echo "  log show --last 5m --style compact --predicate 'sender == \"Sandbox\"' | grep -E 'llama-server|node|deny'"
        return 1
    fi
    echo "All checks passed."
}

# --- Serving checks and benchmarks: requests to the running server, from outside the sandboxes, as pi would send them

# Sets SERVED and SERVED_CTX from the running server, and the folder for request files
serving_ready() {
    local props
    server_healthy || die "no server answers on port $PORT: start it with ./loop up"
    props=$(curl -fsS -m 10 -H "Authorization: Bearer $LOOP_API_KEY" "$BASE_URL/props" 2>/dev/null) \
        || die "the server refused the API key: restart it with ./loop restart"
    SERVED=$(jq -r '.model_alias // "unknown"' <<<"$props")
    SERVED_CTX=$(jq -r '.default_generation_settings.n_ctx // 0' <<<"$props")
    CHECK_DIR="$STATE/serve-check"
    mkdir -p "$CHECK_DIR"
    echo "Server on port $PORT: $SERVED, context $SERVED_CTX. Requests queue behind pi's, so leave it idle."
}

# request PATH BODY_FILE: sets RESP to the response's body and CODE to its HTTP status (000 when there was none)
request() {
    local out
    out=$(curl -sS -m "${LOOP_CHECK_TIMEOUT:-900}" -X POST -H "Authorization: Bearer $LOOP_API_KEY" \
        -H 'Content-Type: application/json' --data-binary "@$2" -w '\n%{http_code}' "$BASE_URL$1" 2>/dev/null) \
        || out=$'\n000'
    CODE=${out##*$'\n'}
    RESP=${out%$'\n'*}
}

error_text() { jq -r '.error.message // .' <<<"$RESP" 2>/dev/null | head -c 200 || echo "HTTP $CODE"; }

# count_tokens < TEXT: the server's own count
count_tokens() {
    jq -Rs '{content: .}' > "$CHECK_DIR/tokenize.json"
    request /tokenize "$CHECK_DIR/tokenize.json"
    jq '.tokens | length' <<<"$RESP" 2>/dev/null || echo 0
}

filler_lines() {
    awk -v n="$1" 'BEGIN { for (i = 1; i <= n; i++)
        printf "Note %d: the server reads this line as part of a long prompt, and nothing in it needs an answer.\n", i }'
}

# filler TOKENS FILE: about that many tokens, after a nonce so that no cached prompt matches
filler() {
    if [ -z "${LINE_TOKENS20:-}" ]; then
        LINE_TOKENS20=$(filler_lines 20 | count_tokens)
        [ "$LINE_TOKENS20" -gt 0 ] || die "the server's /tokenize did not answer: $(error_text)"
    fi
    { echo "Run $RANDOM$RANDOM."; filler_lines $(( $1 * 20 / LINE_TOKENS20 )); } > "$2"
}

# chat_body PROMPT_FILE MAX_TOKENS THINKING [EXTRA_JSON]: a request as pi sends it, with thinking on or off
chat_body() {
    local extra=${4:-}
    [ -n "$extra" ] || extra='{}'
    jq -n --rawfile p "$1" --argjson max "$2" --argjson think "$3" --argjson extra "$extra" '
        {model: "sensenova-loop", messages: [{role: "user", content: $p}], max_tokens: $max, stream: false,
         cache_prompt: false, chat_template_kwargs: {enable_thinking: $think}}
        + $extra'
}

# chat PROMPT_FILE MAX_TOKENS THINKING [EXTRA_JSON]
chat() {
    chat_body "$@" > "$CHECK_DIR/request.json"
    request /v1/chat/completions "$CHECK_DIR/request.json"
}

# What a response's timings say about reading the prompt
prefill_text() {
    jq -r '.timings | "\(.prompt_n) tokens read in \(.prompt_ms / 100 | round / 10) s, \(.prompt_per_second | round) tokens/s"' \
        <<<"$RESP" 2>/dev/null || echo "no timings"
}

CHECK_FAILS=0
CHECK_WARNS=0
verdict() { # ok|FAIL|warn, label, detail
    printf '  %-5s %s%s\n' "$1" "$2" "${3:+  ($3)}"
    case "$1" in
        FAIL) CHECK_FAILS=$(( CHECK_FAILS + 1 )) ;;
        warn) CHECK_WARNS=$(( CHECK_WARNS + 1 )) ;;
    esac
}

cmd_check() {
    serving_ready
    local f="$CHECK_DIR/prompt.txt" started=$SECONDS n target reserve maxout budget thought
    echo "Each check waits for the model; the last three read long prompts, and can take minutes on a small Mac."

    echo 'Reply with the single word: ready' > "$f"
    chat "$f" 64 false
    if [ "$CODE" != 200 ]; then verdict FAIL "it answers with thinking off" "$(error_text)"
    elif jq -e '(.choices[0].message.content // "" | length > 0) and (.choices[0].message.reasoning_content // "" | length == 0)' <<<"$RESP" >/dev/null
    then verdict ok "it answers with thinking off"
    else verdict FAIL "it answers with thinking off" "empty answer, or it thought anyway"; fi

    # pi's thinking levels differ by budget alone, through llama.cpp's thinking_budget_tokens
    budget=256
    echo 'In one sentence: why is the sky blue?' > "$f"
    chat "$f" 2048 true "{\"thinking_budget_tokens\": $budget}"
    if [ "$CODE" != 200 ]; then verdict FAIL "thinking stays within its budget" "$(error_text)"
    else
        thought=$(jq -r '.choices[0].message.reasoning_content // ""' <<<"$RESP" | count_tokens)
        if ! jq -e '.choices[0].message.content // "" | length > 0' <<<"$RESP" >/dev/null; then
            verdict FAIL "thinking stays within its budget" "no answer after $thought tokens of thinking"
        elif [ "$thought" -le $(( budget + budget / 10 + 32 )) ]; then
            verdict ok "thinking stays within its budget" "$thought of $budget tokens"
        else
            verdict FAIL "thinking stays within its budget" "$thought tokens for a budget of $budget"
        fi
    fi

    # A preview model may get the tool syntax wrong at times, so a miss is a warning
    echo 'Read the file notes.txt in the current folder.' > "$f"
    chat "$f" 512 false '{"tools": [{"type": "function", "function": {"name": "read_file",
        "description": "Read a text file", "parameters": {"type": "object",
        "properties": {"path": {"type": "string"}}, "required": ["path"]}}}]}'
    if [ "$CODE" != 200 ]; then verdict FAIL "a tool call is well formed" "$(error_text)"
    elif jq -e '.choices[0].message.tool_calls[0].function | .name == "read_file"
                and (.arguments | fromjson | .path | type == "string")' <<<"$RESP" >/dev/null 2>&1
    then verdict ok "a tool call is well formed"
    else verdict warn "a tool call is well formed" "no valid read_file call"; fi

    target=$(( SERVED_CTX * 85 / 100 ))
    filler "$target" "$f"
    chat "$f" 16 false
    if [ "$CODE" != 200 ]; then verdict FAIL "it reads a prompt of 85% of the context" "$(error_text)"
    else
        n=$(jq '.timings.prompt_n // 0' <<<"$RESP")
        if [ "$n" -ge $(( target * 8 / 10 )) ]; then verdict ok "it reads a prompt of 85% of the context" "$(prefill_text)"
        else verdict FAIL "it reads a prompt of 85% of the context" "only $n tokens read"; fi
    fi

    # pi compacts and retries once when a request overflows, if the error matches its pattern for llama.cpp
    filler $(( SERVED_CTX + 256 )) "$f"
    chat "$f" 16 false
    if [ "$CODE" = 200 ]; then verdict FAIL "an overflow is reported in the words pi recognizes" "a longer prompt than the context was accepted"
    elif jq -e '.error.message // "" | test("exceeds the available context size"; "i")' <<<"$RESP" >/dev/null 2>&1
    then verdict ok "an overflow is reported in the words pi recognizes" "HTTP $CODE"
    else verdict FAIL "an overflow is reported in the words pi recognizes" "HTTP $CODE: $(error_text)"; fi

    # As pi asks for a summary: past the extension, so the server's default budget, with 80% of the reserve as
    # its output limit, after a conversation that fills the context up to the reserve
    reserve=$(( SERVED_CTX / 4 )); [ "$reserve" -le 24576 ] || reserve=24576
    maxout=$(( reserve * 8 / 10 ))
    filler $(( SERVED_CTX - reserve - 512 )) "$f"
    printf '\nSummarize the notes above for a colleague who will continue the work: what they are, and what is left to do.\n' >> "$f"
    chat "$f" "$maxout" true
    if [ "$CODE" != 200 ]; then verdict FAIL "a compaction summary fits its output limit" "$(error_text)"
    else
        thought=$(jq -r '.choices[0].message.reasoning_content // ""' <<<"$RESP" | count_tokens)
        if jq -e '.choices[0].finish_reason == "stop" and (.choices[0].message.content // "" | length > 0)' <<<"$RESP" >/dev/null
        then verdict ok "a compaction summary fits its output limit" "$thought tokens of thinking, limit $maxout; $(prefill_text)"
        elif jq -e '.choices[0].finish_reason == "length"' <<<"$RESP" >/dev/null
        then verdict FAIL "a compaction summary fits its output limit" "cut off at $maxout tokens, $thought of them thinking: lower LOOP_REASONING_BUDGET"
        else verdict FAIL "a compaction summary fits its output limit" "an empty summary"; fi
    fi

    echo
    echo "$CHECK_FAILS failed, $CHECK_WARNS warning(s), in $(( SECONDS - started )) s."
    [ "$CHECK_FAILS" = 0 ]
}

cmd_bench() {
    local sizes=${*:-512 2048 8192} gen=128 size f row machine n pps first gps gen_n
    for size in $sizes; do case "$size" in *[!0-9]*|'') die "bench takes prompt sizes in tokens, not $size" ;; esac; done
    serving_ready
    f="$CHECK_DIR/prompt.txt"
    machine=$(jq -cn --arg model "$(sysctl -n hw.model 2>/dev/null || echo unknown)" \
        --arg chip "$(sysctl -n machdep.cpu.brand_string 2>/dev/null || echo unknown)" \
        --arg macos "$(sw_vers -productVersion 2>/dev/null || echo unknown)" --argjson ram "$(mem_gb)" \
        '{mac: $model, chip: $chip, macos: $macos, ram_gb: $ram}')
    # The first request after a start also compiles Metal's kernels
    echo 'Reply with the single word: ready' > "$f"
    chat "$f" 8 false
    [ "$CODE" = 200 ] || die "the warm-up request failed: $(error_text)"
    printf '  %-8s %-16s %-13s %s\n' PROMPT 'PREFILL' 'FIRST TOKEN' 'GENERATION'
    for size in $sizes; do
        if [ $(( size + gen + 256 )) -gt "$SERVED_CTX" ]; then
            echo "  skip     $size tokens do not fit the context ($SERVED_CTX)"; continue
        fi
        filler "$size" "$f"
        chat "$f" "$gen" false '{"ignore_eos": true}'
        [ "$CODE" = 200 ] || die "the request of $size tokens failed: $(error_text)"
        row=$(jq -r '.timings | [.prompt_n, (.prompt_per_second | round), (.prompt_ms / 100 | round / 10),
            (.predicted_per_second * 10 | round / 10), .predicted_n] | @tsv' <<<"$RESP")
        IFS=$'\t' read -r n pps first gps gen_n <<<"$row"
        printf '  %-8s %-16s %-13s %s\n' "$n" "$pps tokens/s" "$first s" "$gps tokens/s ($gen_n tokens)"
        jq -c --arg date "$(date -u +%Y-%m-%dT%H:%M:%SZ)" --arg served "$SERVED" --argjson ctx "$SERVED_CTX" \
            --arg runtime "$RUNTIME_ID" --argjson machine "$machine" \
            '{date: $date, model: $served, ctx: $ctx, runtime: $runtime} + $machine + (.timings | {
                prompt_tokens: .prompt_n, prefill_tps: .prompt_per_second, first_token_ms: .prompt_ms,
                generated_tokens: .predicted_n, generation_tps: .predicted_per_second})' <<<"$RESP" >> "$STATE/bench.jsonl"
    done
    echo "Results added to $STATE/bench.jsonl"
}

usage() {
    cat <<'EOF'
Usage: ./loop [command]
  pi        set up if needed, start the server, open pi (the default); arguments go to pi
  setup     check the tools, build llama.cpp's SenseNova Loop fork, download the model and pi
  models    list the quants, and which is downloaded, selected and running
  use       switch the server, and keep the choice: ./loop use Q4_0, a context (32K or auto), or cpu or metal for
            the routing. Builds and downloads what is missing, and brings the old server back if the new one fails
  ctx       choose the context size from a list, with the memory each needs; or ./loop ctx 32K
  up        start the server in the background and wait until it is ready
  down      stop the server
  restart   down, then up
  detect    list the SenseNova Loop servers that the agent's sandbox can see
  shell     a shell in the agent's sandbox, in the workspace
  logs      follow the server's log
  status    what is running
  doctor    check that the sandboxes allow and refuse what they should
  check     check that the running server serves pi correctly: thinking, tool calls, long prompts, overflow, compaction
  bench     measure prefill and generation speed; prompt sizes in tokens may follow (default 512 2048 8192)
EOF
}

command=${1:-pi}
[ $# -eq 0 ] || shift
case "$command" in
    -h|--help|help) usage; exit 0 ;;
    pi|setup|models|use|ctx|up|down|restart|detect|shell|logs|status|doctor|check|bench) ;;
    *) usage >&2; exit 2 ;;
esac

load_config
case "$command" in
    pi)      cmd_up; agent_run "$ROOT/agent/bin/pi" "$@" ;;
    setup)   cmd_setup ;;
    models)  cmd_models ;;
    use)     cmd_use "$@" ;;
    ctx)     cmd_ctx "$@" ;;
    up)      cmd_up ;;
    down)    cmd_down ;;
    restart) cmd_down; cmd_up ;;
    detect)  require_setup; agent_run "$ROOT/agent/bin/loop-detect" ;;
    shell)   require_setup; agent_run /bin/bash ;;
    logs)    tail -n 200 -f "$LOG_FILE" ;;
    status)  cmd_status ;;
    doctor)  cmd_doctor ;;
    check)   cmd_check ;;
    bench)   cmd_bench "$@" ;;
esac
