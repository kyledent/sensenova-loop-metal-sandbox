+// SenseNova Loop's residual-stream routing, as ggml-cpu computes it (see ggml_compute_forward_mhc_route/_merge)
+int ggml_metal_op_mhc(ggml_metal_op_t ctx, int idx) {
+    ggml_tensor * op = ctx->node(idx);
+
+    ggml_metal_encoder_t enc = ctx->enc;
+    auto pipeline = ggml_metal_library_get_pipeline_mhc(ctx->lib, op);
+
+    const ggml_tensor * a = op->src[0];
+    const ggml_tensor * b = op->src[1];
+
+    const int32_t n_embd  = (int32_t) a->ne[0];
+    const int     nth_max = std::min(256, ggml_metal_pipeline_max_theads_per_threadgroup(pipeline));
+
+    ggml_metal_encoder_set_pipeline(enc, pipeline);
+
+    switch (op->op) {
+        case GGML_OP_MHC_ROUTE:
+            {
+                const ggml_tensor * w    = op->src[2];
+                const ggml_tensor * bias = op->src[3];
+
+                GGML_ASSERT(w->ne[0] == 2*a->ne[0] && w->ne[1] == 8);
+                GGML_ASSERT(op->ne[0] == a->ne[0] + 6);
+
+                ggml_metal_kargs_mhc_route args = {
+                    /*.n_embd =*/ n_embd,
+                    /*.nb_a1  =*/ a->nb[1],
+                    /*.nb_a2  =*/ a->nb[2],
+                    /*.nb_b1  =*/ b->nb[1],
+                    /*.nb_b2  =*/ b->nb[2],
+                    /*.nb_w1  =*/ w->nb[1],
+                    /*.nb_d1  =*/ op->nb[1],
+                    /*.nb_d2  =*/ op->nb[2],
+                };
+
+                ggml_metal_encoder_set_bytes (enc, &args, sizeof(args), 0);
+                ggml_metal_encoder_set_buffer(enc, ggml_metal_get_buffer_id(a),    1);
+                ggml_metal_encoder_set_buffer(enc, ggml_metal_get_buffer_id(b),    2);
+                ggml_metal_encoder_set_buffer(enc, ggml_metal_get_buffer_id(w),    3);
+                ggml_metal_encoder_set_buffer(enc, ggml_metal_get_buffer_id(bias), 4);
+                ggml_metal_encoder_set_buffer(enc, ggml_metal_get_buffer_id(op),   5);
+
+                // One threadgroup per token and stream, of whole SIMD groups. Its memory holds each SIMD group's
+                // nine partial sums, then the eight gates.
+                const int nth = std::max(32, nth_max - nth_max % 32);
+                const int nsg = nth/32;
+
+                ggml_metal_encoder_set_threadgroup_memory_size(enc, GGML_PAD((9*nsg + 8)*sizeof(float), 16), 0);
+                ggml_metal_encoder_dispatch_threadgroups(enc, a->ne[1], a->ne[2], 1, nth, 1, 1);
+            } break;
+        case GGML_OP_MHC_MERGE:
+            {
+                const ggml_tensor * x      = op->src[2];
+                const ggml_tensor * packed = op->src[3];
+
+                GGML_ASSERT(packed->ne[0] == a->ne[0] + 6);
+                GGML_ASSERT(op->ne[0] == 2*a->ne[0]);
+
+                ggml_metal_kargs_mhc_merge args = {
+                    /*.n_embd =*/ n_embd,
+                    /*.nb_a1  =*/ a->nb[1],
+                    /*.nb_a2  =*/ a->nb[2],
+                    /*.nb_b1  =*/ b->nb[1],
+                    /*.nb_b2  =*/ b->nb[2],
+                    /*.nb_x1  =*/ x->nb[1],
+                    /*.nb_x2  =*/ x->nb[2],
+                    /*.nb_p1  =*/ packed->nb[1],
+                    /*.nb_p2  =*/ packed->nb[2],
+                    /*.nb_d1  =*/ op->nb[1],
+                    /*.nb_d2  =*/ op->nb[2],
+                };
+
+                ggml_metal_encoder_set_bytes (enc, &args, sizeof(args), 0);
+                ggml_metal_encoder_set_buffer(enc, ggml_metal_get_buffer_id(a),      1);
+                ggml_metal_encoder_set_buffer(enc, ggml_metal_get_buffer_id(b),      2);
+                ggml_metal_encoder_set_buffer(enc, ggml_metal_get_buffer_id(x),      3);
+                ggml_metal_encoder_set_buffer(enc, ggml_metal_get_buffer_id(packed), 4);
+                ggml_metal_encoder_set_buffer(enc, ggml_metal_get_buffer_id(op),     5);
+
+                // Elementwise: one thread per element of a row, a row per token and stream
+                const int nth = std::min(nth_max, (int) n_embd);
+                ggml_metal_encoder_dispatch_threadgroups(enc, (n_embd + nth - 1)/nth, a->ne[1], a->ne[2], nth, 1, 1);
+            } break;
+        default:
+            GGML_ABORT("fatal error");
+    }
+
+    return 1;
+}
